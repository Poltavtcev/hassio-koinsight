#!/usr/bin/env bash
# OpenOMS Next.js dashboard — standalone Node bundle from the upstream image.
set -euo pipefail
exec 2>&1

# shellcheck disable=SC1091
source /run/openoms/env

# Wait briefly for the API to come up so the dashboard's proxy resolves cleanly.
for _ in $(seq 1 30); do
    if /usr/local/bin/openoms-healthcheck 2>/dev/null; then
        break
    fi
    sleep 1
done

cd /opt/openoms/dashboard

export PORT="${DASHBOARD_PORT:-3000}"
export HOSTNAME="0.0.0.0"
export DASHBOARD_API_PROXY_URL="${DASHBOARD_API_PROXY_URL:-http://127.0.0.1:8080}"
export NEXT_PUBLIC_API_URL="${NEXT_PUBLIC_API_URL:-}"
export NEXT_PUBLIC_INPOST_GEOWIDGET_TOKEN="${INPOST_GEOWIDGET_TOKEN:-}"

echo "[dashboard] starting Next.js on :${PORT}"
exec node server.js
